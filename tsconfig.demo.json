{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "outDir": "demo/build",
    "rootDir": "demo",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "moduleDetection": "legacy"
  },
  "include": [
    "demo/**/*.ts"
  ]
}
