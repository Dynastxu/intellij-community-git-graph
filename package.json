{
  "name": "@dynastxu/intellij-community-git-graph",
  "version": "0.1.0",
  "description": "Git commit DAG layout ported from the IntelliJ Community Edition VCS log graph",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lib": "tsc -p tsconfig.json",
    "build:demo": "pnpm -C packages/demo build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -C packages/demo typecheck",
    "lint": "eslint . && pnpm -C packages/demo lint",
    "format": "prettier --write . && pnpm -C packages/demo format",
    "test": "node --test --test-isolation=none \"test/*.test.mjs\"",
    "pretest": "pnpm run build && pnpm run build:demo",
    "demo": "pnpm run build && pnpm run build:demo && node packages/demo/build/server.js serve --open",
    "serve:demo": "node packages/demo/build/server.js serve",
    "format:check": "prettier --check . && pnpm -C packages/demo format:check"
  },
  "keywords": [
    "git",
    "commit-graph",
    "dag",
    "vcs-log",
    "intellij",
    "intellisort"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/dynastxu/intellij-community-git-graph.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
