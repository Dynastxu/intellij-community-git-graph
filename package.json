{
  "name": "intellij-community-git-graph",
  "version": "0.1.0",
  "description": "Git commit DAG layout ported from the IntelliJ Community Edition VCS log graph",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:demo && pnpm run bundle",
    "build:lib": "tsc -p tsconfig.json",
    "build:demo": "tsc -p tsconfig.demo.json",
    "bundle": "node demo/build/server.js bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.demo.json --noEmit",
    "test": "node --test --test-isolation=none \"test/*.test.mjs\"",
    "pretest": "pnpm run build",
    "demo": "pnpm run build && node demo/build/server.js serve --open",
    "serve:demo": "node demo/build/server.js serve"
  },
  "keywords": [
    "git",
    "commit-graph",
    "dag",
    "vcs-log",
    "intellij",
    "intellisort"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@12.16.1"
}
