{
  "name": "@dynastxu/git-graph-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Browser demo of the IntelliJ Community VCS log graph port",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build/server.js bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "node build/server.js serve"
  },
  "dependencies": {
    "@dynastxu/intellij-community-git-graph": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "license": "Apache-2.0"
}
